@section Scripts {
    <!-- Load from CDN for client-side validation (falls back to local files if needed) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Local fallback if CDN fails
        (function() {
            if (typeof jQuery === 'undefined') {
                var s = document.createElement('script');
                s.src = '/lib/jquery/dist/jquery.min.js';
                document.head.appendChild(s);
            }
            if (typeof jQuery !== 'undefined' && typeof jQuery.validator === 'undefined') {
                var s2 = document.createElement('script');
                s2.src = '/lib/jquery-validation/dist/jquery.validate.min.js';
                document.head.appendChild(s2);
            }
            if (typeof jQuery !== 'undefined' && typeof jQuery.validator !== 'undefined' && typeof jQuery.validator.unobtrusive === 'undefined') {
                var s3 = document.createElement('script');
                s3.src = '/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js';
                document.head.appendChild(s3);
            }
        })();
    </script>
    <script src="/js/password-toggle.js"></script>
}
