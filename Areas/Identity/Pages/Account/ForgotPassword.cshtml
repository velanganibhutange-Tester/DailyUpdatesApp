@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="login-container">
    <div class="login-card">
        <h1>Forgot your password?</h1>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DevOtp))
        {
            <div class="alert alert-warning" role="alert">
                <strong>Development OTP:</strong> @Model.DevOtp
            </div>
        }

        <form method="post" id="forgotPasswordForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Otp">OTP</label>
                <input asp-for="Input.Otp"
                       id="otpInput"
                       class="form-control"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="Enter 6-digit OTP"
                       autocomplete="one-time-code" />
                <span asp-validation-for="Input.Otp" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.NewPassword">New Password</label>
                <div class="password-field-wrapper">
                    <input asp-for="Input.NewPassword"
                           id="newPasswordInput"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           disabled="disabled" />
                    <button type="button" class="toggle-password-btn" aria-label="Show password" aria-pressed="false"></button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <div class="password-field-wrapper">
                    <input asp-for="Input.ConfirmPassword"
                           id="confirmPasswordInput"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           disabled="disabled" />
                    <button type="button" class="toggle-password-btn" aria-label="Show password" aria-pressed="false"></button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="button-group" style="justify-content: space-between;">
                <button type="submit" asp-page-handler="SendOtp" class="btn btn-primary">Send OTP</button>
                <button type="submit" asp-page-handler="Change" class="btn btn-success" id="changePasswordBtn" disabled="disabled">Change</button>
            </div>

            <div style="margin-top: 15px; text-align: center;">
                <a asp-page="./Login">Back to login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var otp = document.getElementById('otpInput');
            var newPwd = document.getElementById('newPasswordInput');
            var confirmPwd = document.getElementById('confirmPasswordInput');
            var changeBtn = document.getElementById('changePasswordBtn');
            var newPwdToggle = newPwd ? newPwd.parentElement.querySelector('.toggle-password-btn') : null;
            var confirmPwdToggle = confirmPwd ? confirmPwd.parentElement.querySelector('.toggle-password-btn') : null;

            function normalizeOtp(value) {
                return (value || '').replace(/\D/g, '').slice(0, 6);
            }

            function sync() {
                var otpValue = normalizeOtp(otp && otp.value);
                if (otp && otp.value !== otpValue) otp.value = otpValue;

                var enable = otpValue.length === 6;
                if (newPwd) newPwd.disabled = !enable;
                if (confirmPwd) confirmPwd.disabled = !enable;
                if (newPwdToggle) newPwdToggle.disabled = !enable;
                if (confirmPwdToggle) confirmPwdToggle.disabled = !enable;
                if (changeBtn) changeBtn.disabled = !enable;

                // If the user deletes OTP after toggling visibility, snap back to password fields.
                if (!enable) {
                    if (newPwd && newPwd.getAttribute('type') === 'text') newPwd.setAttribute('type', 'password');
                    if (confirmPwd && confirmPwd.getAttribute('type') === 'text') confirmPwd.setAttribute('type', 'password');
                }
            }

            if (otp) {
                otp.addEventListener('input', sync);
                otp.addEventListener('change', sync);
            }

            sync();
        })();
    </script>
}
