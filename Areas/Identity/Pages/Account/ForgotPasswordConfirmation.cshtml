@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="login-container">
    <div class="login-card alert alert-success">
        <h1>Forgot password confirmation</h1>
        <p>Please check your email to reset your password.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ResetLink))
        {
            <hr />
            <p><strong>Development mode:</strong> use this reset link:</p>
            <p><a href="@Model.ResetLink">Reset your password</a></p>
        }
    </div>
</div>
