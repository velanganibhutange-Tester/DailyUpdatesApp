@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="login-container">
    <div class="login-card">
        <h1>Reset password</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">New password</label>
                <div class="password-field-wrapper">
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                    <button type="button" class="toggle-password-btn" aria-label="Show password" aria-pressed="false"></button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <div class="password-field-wrapper">
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <button type="button" class="toggle-password-btn" aria-label="Show password" aria-pressed="false"></button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">Reset password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

